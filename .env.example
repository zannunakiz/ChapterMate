# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MongoDB (Atlas connection string)
MONGODB_URI=

# Optional: DNS servers used only when the system resolver cannot resolve
# MongoDB Atlas SRV records (comma separated). Defaults to
# 8.8.8.8,1.1.1.1,8.8.4.4,1.0.0.1 (see lib/dns-bootstrap.ts).
DNS_SERVERS=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Vapi
NEXT_PUBLIC_VAPI_API_KEY=
NEXT_PUBLIC_ASSISTANT_ID=

# Feature Flags
FF_DUMMY_BOOKS=
FF_DUMMY_FORM=

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=